pipeline {
    agent any
    
    environment {
        GITHUB_TOKEN = credentials('github-token')
        REPO_NAME = 'blog'
        GITHUB_USER = 'gabi89luch'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Terraform Init & Plan') {
            steps {
                script {
                    // Set GitHub token for Terraform
                    withCredentials([string(credentialsId: 'github-token', variable: 'TF_VAR_github_token')]) {
                        sh '''
                            terraform init
                            terraform plan -out=tfplan
                        '''
                    }
                }
            }
        }
        
        stage('Terraform Apply') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'github-token', variable: 'TF_VAR_github_token')]) {
                        sh 'terraform apply -auto-approve tfplan'
                    }
                }
            }
        }
        
        stage('Validate Website Files') {
            steps {
                script {
                    // HTML validation
                    sh '''
                        for file in *.html; do
                            echo "Validating $file"
                            tidy -q -e "$file" || true
                        done
                    '''
                    
                    // CSS validation
                    sh '''
                        if [ -d "css" ]; then
                            for file in css/*.css; do
                                echo "Checking $file"
                                csslint "$file" || true
                            done
                        fi
                    '''
                }
            }
        }
        
        stage('Deploy to GitHub Pages') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                        sh '''
                            git config user.email "jenkins@example.com"
                            git config user.name "Jenkins CI"
                            
                            if git show-ref --verify --quiet refs/heads/gh-pages; then
                                git checkout gh-pages
                            else
                                git checkout -b gh-pages
                            fi
                            
                            cp -r * ../temp/
                            git rm -rf .
                            cp -r ../temp/* .
                            rm -rf ../temp
                            
                            git add .
                            git commit -m "Deploy website update via Jenkins"
                            git push https://${GITHUB_TOKEN}@github.com/${GITHUB_USER}/${REPO_NAME}.git gh-pages --force
                        '''
                    }
                }
            }
        }
    }
    
    post {
        success {
            script {
                sh """
                    curl -X POST \
                    -H "Authorization: token ${GITHUB_TOKEN}" \
                    -H "Accept: application/vnd.github.v3+json" \
                    https://api.github.com/repos/${GITHUB_USER}/${REPO_NAME}/issues \
                    -d '{
                        "title": "✅ Deployment Successful",
                        "body": "Infrastructure and website deployed successfully",
                        "labels": ["deployment", "success"]
                    }'
                """
            }
        }
        failure {
            script {
                sh """
                    curl -X POST \
                    -H "Authorization: token ${GITHUB_TOKEN}" \
                    -H "Accept: application/vnd.github.v3+json" \
                    https://api.github.com/repos/${GITHUB_USER}/${REPO_NAME}/issues \
                    -d '{
                        "title": "❌ Deployment Failed",
                        "body": "Deployment failed - check Jenkins logs",
                        "labels": ["deployment", "failure"]
                    }'
                """
            }
        }
        always {
            cleanWs()
        }
    }
}
